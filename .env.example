# Копировать в .env (dev) — .env в git не коммитится.
# Обязательные переменные валидируются при старте в src/lib/config.ts.

# development | production — независимо от NODE_ENV, сверяется с
# EnvironmentGuard в БД при старте (ARCHITECTURE.md §11.1).
APP_ENV=development

NODE_ENV=development

# Строка подключения к PostgreSQL. dev и prod ДОЛЖНЫ указывать на физически
# разные инстансы (ARCHITECTURE.md §11.1, DEPLOYMENT.md) — никогда не
# переиспользовать один и тот же URL между окружениями.
DATABASE_URL=postgresql://kontrol_metalla:kontrol_metalla_dev@localhost:5432/kontrol_metalla

# Секрет для подписи/шифрования служебных данных admin-сессии.
# Не пароль администратора — секрет уровня приложения. Минимум 32 символа.
# Сгенерировать пример: openssl rand -base64 32
SESSION_COOKIE_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# Публичный HTTPS-домен приложения (в dev — http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000
